{
  "mcp_servers": {
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone=America/New_York"
      ]
    },
    "ddg-search": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:/Users/wayne/AppData/Local/Programs/open-llm-vtuber/Open-LLM-VTuber/nakia_memory.jsonl"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/Nakia Stuff"
      ]
    },
    "pdf-reader": {
      "command": "uvx",
      "args": [
        "mcp-pdf-reader"
      ]
    },
    "word": {
      "command": "uvx",
      "args": [
        "--from",
        "office-word-mcp-server",
        "word_mcp_server"
      ]
    },
    "images": {
      "command": "uvx",
      "args": [
        "imagesorcery-mcp"
      ]
    }
  }
}
